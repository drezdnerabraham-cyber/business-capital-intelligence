NEXT_PUBLIC_SUPABASE_URL=https://sphnjdoeqvrryzvdyzgk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Admin login is a real Supabase Auth user (email/password), created directly in the
# auth.users table — there's no separate admin credential env var anymore. Manage the
# admin account from the Supabase dashboard's Authentication > Users page.

# Webhook secret — REQUIRED for external callers to POST /api/route (the
# intake-form → routing hook). Callers must send it as `x-webhook-secret`.
# If unset the endpoint still accepts requests from a logged-in admin
# session, but external form-tool traffic will be rejected with 401.
WEBHOOK_SECRET=
